FROM python:3.12-slim

RUN apt-get update && apt-get install --no-install-recommends -y libgomp1 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /bin/
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/opt/stacks-venv
ENV PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen
COPY . .
CMD ["/bin/sh", "-c", "uv run python scripts/crosscheck_obp.py && uv run python scripts/build_evidence.py && uv run python scripts/build_neural_evidence.py && uv run python scripts/render_reports.py && uv run python scripts/build_notebooks.py"]

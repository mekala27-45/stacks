# Local development. Do not commit .env or real secrets.
DATABASE_URL=sqlite:///./.runtime/stacks.db
STACKS_DATA_DIR=web/public/data
SESSION_HASH_KEY=replace-with-a-persistent-random-secret-before-deploying
ADMIN_TOKEN=replace-with-a-separate-administrative-secret
CORS_ORIGINS=http://localhost:3010,http://localhost:5173,http://localhost:3000
# For deployed persistence, use an externally provisioned PostgreSQL database:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
